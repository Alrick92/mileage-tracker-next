generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum Unit {
  KM
  MI
}

enum Locale {
  EN
  FR
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(USER)
  enabled      Boolean  @default(false)
  unit         Unit     @default(MI)
  locale       Locale   @default(EN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  trips Trip[]
}

model Vehicle {
  id              String   @id @default(cuid())
  name            String
  make            String?
  model           String?
  year            Int?
  licensePlate    String?  @unique
  currentOdometer Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  trips Trip[]
}

model Trip {
  id            String   @id @default(cuid())
  vehicleId     String
  userId        String
  driverName    String
  date          DateTime
  startOdometer Int
  endOdometer   Int
  fuelLiters    Float?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([vehicleId, date])
  @@index([userId, date])
}
