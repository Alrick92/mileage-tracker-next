# Copy to .env and adjust as needed.
#
# Two deployment modes are supported:
#
#   1. Local dev (host Node + dockerized Postgres only):
#        DATABASE_URL="postgresql://mileage:mileage@localhost:5432/mileage?schema=public"
#        docker compose up -d db
#        npm install && npx prisma migrate dev && npm run seed:admin && npm run dev
#
#   2. Full stack via docker compose (app + db both containerized):
#        docker compose up --build
#      The app service uses DATABASE_URL=postgresql://<user>:<pw>@db:5432/<db>?schema=public
#      automatically; you only need to set AUTH_SECRET, ADMIN_EMAIL, ADMIN_PASSWORD here.
DATABASE_URL="postgresql://mileage:mileage@localhost:5432/mileage?schema=public"

# Secret used to sign session JWTs. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string"

# First admin account. Seeded/refreshed automatically on container start when
# running via `docker compose up`, or manually via `npm run seed:admin` when
# running Node on the host. New self-registered users are disabled by default
# and must be enabled by this admin from /admin/users.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-8+-chars"
ADMIN_NAME="Admin"

# Optional overrides for docker compose. Defaults match the values above.
# POSTGRES_USER=mileage
# POSTGRES_PASSWORD=mileage
# POSTGRES_DB=mileage
# POSTGRES_PORT=5432
# APP_PORT=3000
